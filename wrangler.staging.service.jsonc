{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fahrzeugakte-test-service",
  "main": "auth/dist/service.js",
  "compatibility_date": "2026-10-27",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "vars": {
    "APP_ORIGIN": "https://fahrzeugakte-test.pages.dev",
    "CLERK_ISSUER": "https://CLERK_TEST_HOST_EINTRAGEN",
    "CLERK_PUBLISHABLE_KEY": "CLERK_TEST_PUBLISHABLE_KEY_EINTRAGEN",
    "MAIL_FROM": "Fahrzeugakte Test <onboarding@resend.dev>",
    "AUTOMATION_ENABLED": "false"
  },
  "d1_databases": [
    {
      "binding": "DATA_DB",
      "database_name": "fahrzeugakte-test-daten",
      "database_id": "TEST_D1_ID_EINTRAGEN",
      "migrations_dir": "auth/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "fahrzeugakte-test-originale"
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  },
  "no_bundle": true,
  "find_additional_modules": false
}
