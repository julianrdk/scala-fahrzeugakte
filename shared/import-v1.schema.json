{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://scala-fahrzeugakte.invalid/schemas/import-v1.json",
  "title": "Fahrzeugakte JSON-Vertrag v1",
  "type": "object",
  "properties": {
    "format": {
      "const": "vehicle-record-import"
    },
    "schema_version": {
      "const": 1
    },
    "import_id": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 10000
        },
        {
          "type": "null"
        }
      ]
    },
    "vehicle_label": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 10000
        },
        {
          "type": "null"
        }
      ]
    },
    "documents": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/document"
      },
      "maxItems": 100
    },
    "expenses": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/expense"
      },
      "maxItems": 100
    },
    "work": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/work"
      },
      "maxItems": 100
    },
    "reminders": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/reminder"
      },
      "maxItems": 100
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 10000
      },
      "maxItems": 100
    }
  },
  "required": [
    "format",
    "schema_version",
    "import_id",
    "vehicle_label",
    "documents",
    "expenses",
    "work",
    "reminders",
    "warnings"
  ],
  "additionalProperties": false,
  "definitions": {
    "document": {
      "type": "object",
      "properties": {
        "ref": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,100}$"
        },
        "source_filename": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 10000
            },
            {
              "type": "null"
            }
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "document_type": {
          "enum": [
            "invoice",
            "receipt",
            "contract",
            "approval",
            "inspection",
            "service_history",
            "photo",
            "other"
          ]
        },
        "page_numbers": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "ref",
        "source_filename",
        "title",
        "document_type"
      ],
      "additionalProperties": false
    },
    "expense": {
      "type": "object",
      "properties": {
        "ref": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,100}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "category": {
          "enum": [
            null,
            "Tanken",
            "Wartung & Reparatur",
            "Umbauten & Zubehör",
            "Versicherung & Steuer",
            "Parken & Gebühren",
            "Pflege",
            "Fahrzeugkauf & Verkauf",
            "Sonstiges"
          ]
        },
        "date": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "odometer_km": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 10000000
            },
            {
              "type": "null"
            }
          ]
        },
        "amount_cents": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -10000000000,
              "maximum": 10000000000
            },
            {
              "type": "null"
            }
          ]
        },
        "currency": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "vendor": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 10000
            },
            {
              "type": "null"
            }
          ]
        },
        "invoice_number": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 10000
            },
            {
              "type": "null"
            }
          ]
        },
        "document_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,100}$"
          },
          "uniqueItems": true,
          "maxItems": 100
        },
        "notes": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 10000
            },
            {
              "type": "null"
            }
          ]
        },
        "cashflow_type": {
          "enum": [
            "expense",
            "income"
          ]
        },
        "fuel": {
          "type": "object",
          "properties": {
            "liters": {
              "anyOf": [
                {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 1000
                },
                {
                  "type": "null"
                }
              ]
            },
            "fuel_type": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 10000
                },
                {
                  "type": "null"
                }
              ]
            },
            "full_tank": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            },
            "missed_previous_fillup": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            },
            "station_name": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 10000
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "liters",
            "fuel_type",
            "full_tank",
            "missed_previous_fillup",
            "station_name"
          ],
          "additionalProperties": false
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "description": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 10000
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "part_number": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 10000
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "quantity": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 10000000
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "unit": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 10000
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "specification": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 10000
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "description",
              "part_number",
              "quantity",
              "unit"
            ],
            "additionalProperties": false
          },
          "maxItems": 100
        }
      },
      "required": [
        "ref",
        "title",
        "category",
        "date",
        "odometer_km",
        "amount_cents",
        "currency",
        "vendor",
        "invoice_number",
        "document_refs",
        "notes"
      ],
      "additionalProperties": false
    },
    "work": {
      "type": "object",
      "properties": {
        "ref": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,100}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "kind": {
          "enum": [
            "maintenance",
            "repair",
            "modification",
            "inspection",
            "other"
          ]
        },
        "status": {
          "enum": [
            "completed",
            "planned"
          ]
        },
        "date": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "odometer_km": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 10000000
            },
            {
              "type": "null"
            }
          ]
        },
        "performed_by": {
          "enum": [
            "self",
            "workshop",
            "unknown"
          ]
        },
        "description": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 10000
            },
            {
              "type": "null"
            }
          ]
        },
        "expense_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,100}$"
          },
          "uniqueItems": true,
          "maxItems": 100
        },
        "document_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,100}$"
          },
          "uniqueItems": true,
          "maxItems": 100
        },
        "parts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "description": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 10000
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "part_number": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 10000
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "quantity": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 10000000
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "unit": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 10000
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "specification": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 10000
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "description",
              "part_number",
              "quantity",
              "unit"
            ],
            "additionalProperties": false
          },
          "maxItems": 100
        },
        "estimated_cost_cents": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000000000
            },
            {
              "type": "null"
            }
          ]
        },
        "modification_details": {
          "type": "object",
          "properties": {
            "manufacturer": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 10000
                },
                {
                  "type": "null"
                }
              ]
            },
            "part_number": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 10000
                },
                {
                  "type": "null"
                }
              ]
            },
            "approval_number": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 10000
                },
                {
                  "type": "null"
                }
              ]
            },
            "status": {
              "enum": [
                "planned",
                "installed",
                "removed"
              ]
            },
            "installation_date": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "installation_odometer_km": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 10000000
                },
                {
                  "type": "null"
                }
              ]
            },
            "removal_date": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "removal_odometer_km": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 10000000
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "manufacturer",
            "part_number",
            "approval_number",
            "status"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "ref",
        "title",
        "kind",
        "status",
        "date",
        "odometer_km",
        "performed_by",
        "description",
        "expense_refs",
        "document_refs"
      ],
      "additionalProperties": false
    },
    "reminder": {
      "type": "object",
      "properties": {
        "ref": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,100}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "work_type": {
          "enum": [
            "maintenance",
            "repair",
            "modification",
            "inspection",
            "other"
          ]
        },
        "due_date": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "due_odometer_km": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 10000000
            },
            {
              "type": "null"
            }
          ]
        },
        "repeat_months": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000000
            },
            {
              "type": "null"
            }
          ]
        },
        "repeat_km": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000000
            },
            {
              "type": "null"
            }
          ]
        },
        "lead_days": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000000
            },
            {
              "type": "null"
            }
          ]
        },
        "lead_km": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000000
            },
            {
              "type": "null"
            }
          ]
        },
        "email_enabled": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "basis_work_ref": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,100}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "notes": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 10000
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "ref",
        "title",
        "work_type",
        "due_date",
        "due_odometer_km",
        "repeat_months",
        "repeat_km",
        "lead_days",
        "lead_km",
        "email_enabled",
        "basis_work_ref",
        "notes"
      ],
      "additionalProperties": false
    }
  }
}
