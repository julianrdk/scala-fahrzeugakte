{
  "name": "scala-fahrzeugakte",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "catalog:import": "node scripts/import-kba.mjs",
    "dev": "node scripts/prepare-ocr.mjs && vite --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1",
    "schema": "node scripts/schema.mjs",
    "typecheck": "tsc --noEmit",
    "build": "pnpm validators && pnpm typecheck && node scripts/prepare-ocr.mjs && vite build && pnpm build:service && node scripts/verify-artifacts.mjs",
    "test": "vitest run",
    "check": "pnpm test && pnpm build",
    "configure": "node scripts/configure.mjs",
    "package:source": "node scripts/package-source.mjs",
    "validators": "node scripts/validators.mjs",
    "dev:api": "wrangler dev --config wrangler.local.jsonc --port 8787 --local",
    "db:local": "node scripts/init-local.mjs",
    "test:runtime": "node scripts/test-runtime.mjs",
    "build:service": "node scripts/build-service.mjs",
    "test:large": "node --expose-gc scripts/test-backups-large.mjs",
    "test:browser": "node scripts/browser-dev.mjs"
  },
  "dependencies": {
    "@clerk/backend": "3.26.2",
    "@clerk/localizations": "4.24.1",
    "@clerk/react": "6.18.1",
    "@noble/hashes": "1.8.0",
    "@tesseract.js-data/deu": "1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "ajv": "8.20.0",
    "fflate": "0.8.3",
    "leaflet": "1.9.4",
    "lucide-react": "0.468.0",
    "pdfjs-dist": "6.4.299",
    "react": "19.1.4",
    "react-dom": "19.1.4",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@types/leaflet": "1.9.22",
    "@types/node": "24.10.1",
    "@types/react": "19.1.0",
    "@types/react-dom": "19.1.1",
    "esbuild": "0.28.2",
    "happy-dom": "^21.0.4",
    "prettier": "3.9.10",
    "saxes": "6.0.0",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "wrangler": "4.153.0"
  },
  "packageManager": "pnpm@11.25.0"
}
