{
  "name": "scala-fahrzeugakte",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1",
    "schema": "node scripts/schema.mjs",
    "build:backend": "node scripts/build-backend.mjs",
    "build:auth": "node scripts/build-auth.mjs",
    "typecheck": "tsc --noEmit",
    "build": "pnpm typecheck && vite build && pnpm build:backend && pnpm build:auth && node scripts/verify-artifacts.mjs",
    "test": "vitest run",
    "check": "pnpm test && pnpm build",
    "configure": "node scripts/configure.mjs",
    "package:source": "node scripts/package-source.mjs"
  },
  "dependencies": {
    "@noble/hashes": "1.8.0",
    "ajv": "8.20.0",
    "fflate": "0.8.3",
    "leaflet": "1.9.4",
    "lucide-react": "0.468.0",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@types/leaflet": "1.9.22",
    "@types/node": "24.10.1",
    "@types/react": "19.1.0",
    "@types/react-dom": "19.1.1",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@11.25.0"
}
